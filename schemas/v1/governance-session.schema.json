{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metadatastician/common-signal/schemas/v1/governance-session.schema.json",
  "title": "Common Signal worker-governance session",
  "description": "Privacy-minimised metadata for a real listening or co-design session. Attendance is not endorsement or ratification.",
  "x-spdx-license-identifier": "MPL-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionReference",
    "heldAt",
    "format",
    "constituenciesPresent",
    "mandateKindsPresent",
    "documentsReviewed",
    "recordingStatus",
    "themes",
    "requiredChanges",
    "dissent",
    "knownOmissions",
    "correctionDeadline",
    "withdrawalRoute"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sessionReference": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$" },
    "heldAt": { "type": "string", "format": "date-time" },
    "format": { "enum": ["in-person", "remote", "hybrid", "asynchronous-written", "represented-submission"] },
    "constituenciesPresent": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "journalism-worker",
          "pr-worker",
          "communications-worker",
          "freelance-or-precarious-worker",
          "recognised-union-representative",
          "workplace-representative",
          "equality-representative",
          "health-and-safety-representative"
        ]
      }
    },
    "mandateKindsPresent": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["self", "workplace", "recognised-union", "other-collective"] }
    },
    "documentsReviewed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "recordingStatus": { "enum": ["off", "agreed-audio", "agreed-video", "agreed-transcript"] },
    "themes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "requiredChanges": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "dissent": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "knownOmissions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "correctionDeadline": { "type": "string", "format": "date" },
    "withdrawalRoute": { "type": "string", "minLength": 1 }
  }
}
